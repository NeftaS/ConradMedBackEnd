          },
          "page": {
            "type": "integer",
            "required": false,
            "default": 1,
            "description": "Número de página"
          }
        },
        "responses": {
          "200": {
            "description": "Análisis obtenidos exitosamente",
            "body": {
              "analisis": "array",
              "pagination": "object"
            }
          },
          "401": {
            "description": "No autorizado",
            "body": {
              "error": "string"
            }
          }
        }
      },
      "mostrarAnalisisPorId": {
        "method": "GET",
        "url": "/analisis/mostrar/{id}",
        "description": "Obtener un análisis específico por ID",
        "authentication": "JWT required",
        "headers": {
          "Authorization": "Bearer {JWT_TOKEN}",
          "Accept": "application/json"
        },
        "path_params": {
          "id": {
            "type": "integer",
            "required": true,
            "description": "ID del análisis"
          }
        },
        "responses": {
          "200": {
            "description": "Análisis obtenido exitosamente",
            "body": "analisis_object"
          },
          "401": {
            "description": "No autorizado",
            "body": {
              "error": "string"
            }
          },
          "404": {
            "description": "Análisis no encontrado",
            "body": {
              "error": "string"
            }
          }
        }
      },
      "agregarAnalisis": {
        "method": "POST",
        "url": "/analisis/agendar",
        "description": "Crear un nuevo análisis",
        "authentication": "JWT required",
        "headers": {
          "Authorization": "Bearer {JWT_TOKEN}",
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "body": {
          "fecha": {
            "type": "string",
            "required": true,
            "format": "YYYY-MM-DD HH:mm:ss",
            "description": "Fecha y hora del análisis"
          },
          "tipo_analisis_id": {
            "type": "integer",
            "required": true,
            "description": "ID del tipo de análisis"
          },
          "lugar_id": {
            "type": "integer",
            "required": true,
            "description": "ID del lugar"
          },
          "observaciones": {
            "type": "string",
            "required": false,
            "description": "Observaciones adicionales"
          }
        },
        "responses": {
          "201": {
            "description": "Análisis creado exitosamente",
            "body": {
              "message": "string",
              "analisis": "object"
            }
          },
          "401": {
            "description": "No autorizado",
            "body": {
              "error": "string"
            }
          },
          "422": {
            "description": "Error de validación",
            "body": {
              "error": "object"
            }
          }
        }
      },
      "actualizarAnalisis": {
        "method": "PUT",
        "url": "/analisis/actualizar/{id}",
        "description": "Actualizar un análisis existente",
        "authentication": "JWT required",
        "headers": {
          "Authorization": "Bearer {JWT_TOKEN}",
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "path_params": {
          "id": {
            "type": "integer",
            "required": true,
            "description": "ID del análisis"
          }
        },
        "body": {
          "fecha": {
            "type": "string",
            "required": false,
            "format": "YYYY-MM-DD HH:mm:ss",
            "description": "Nueva fecha y hora del análisis"
          },
          "tipo_analisis_id": {
            "type": "integer",
            "required": false,
            "description": "Nuevo ID del tipo de análisis"
          },
          "lugar_id": {
            "type": "integer",
            "required": false,
            "description": "Nuevo ID del lugar"
          },
          "observaciones": {
            "type": "string",
            "required": false,
            "description": "Nuevas observaciones"
          }
        },
        "responses": {
          "200": {
            "description": "Análisis actualizado exitosamente",
            "body": {
              "message": "string",
              "analisis": "object"
            }
          },
          "401": {
            "description": "No autorizado",
            "body": {
              "error": "string"
            }
          },
          "404": {
            "description": "Análisis no encontrado",
            "body": {
              "error": "string"
            }
          },
          "422": {
            "description": "Error de validación",
            "body": {
              "error": "object"
            }
          }
        }
      },
      "eliminarAnalisis": {
        "method": "GET",
        "url": "/analisis/eliminar/{id}",
        "description": "Eliminar un análisis",
        "authentication": "JWT required",
        "headers": {
          "Authorization": "Bearer {JWT_TOKEN}",
          "Accept": "application/json"
        },
        "path_params": {
          "id": {
            "type": "integer",
            "required": true,
            "description": "ID del análisis"
          }
        },
        "responses": {
          "200": {
            "description": "Análisis eliminado exitosamente",
            "body": {
              "message": "string"
            }
          },
          "401": {
            "description": "No autorizado",
            "body": {
              "error": "string"
            }
          },
          "404": {
            "description": "Análisis no encontrado",
            "body": {
              "error": "string"
            }
          }
        }
      }
    },
    "productos": {
      "mostrarProducto": {
        "method": "GET",
        "url": "/productos/mostrar",
        "description": "Obtener todos los productos",
        "authentication": "No required",
        "headers": {
          "Accept": "application/json"
        },
        "query_params": {
          "per_page": {
            "type": "integer",
            "required": false,
            "default": 15,
            "description": "Número de resultados por página"
          },
          "page": {
            "type": "integer",
            "required": false,
