{
  "api_name": "ConradMed API",
  "version": "1.0.0",
  "base_url": "http://127.0.0.1:8000/api",
  "description": "API completa del sistema ConradMed con autenticación JWT",
  "endpoints": {
    "autenticacion": {
      "login": {
        "method": "POST",
        "url": "/login",
        "description": "Autenticación de usuario solo con teléfono y obtención de token JWT",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "body": {
          "telefono": {
            "type": "string",
            "required": true,
            "min_length": 10,
            "max_length": 10,
            "description": "Número de teléfono del usuario"
          }
        },
        "responses": {
          "200": {
            "description": "Login exitoso",
            "body": {
              "user": {
                "id": "integer",
                "nombre": "string",
                "telefono": "string",
                "email": "string"
              },
              "token": "string"
            }
          },
          "401": {
            "description": "Credenciales inválidas",
            "body": {
              "error": "string"
            }
          },
          "422": {
            "description": "Error de validación",
            "body": {
              "errors": "object"
            }
          }
        }
      },
      "register": {
        "method": "POST",
        "url": "/register",
        "description": "Registro de nuevo usuario",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "body": {
          "nombre": {
            "type": "string",
            "required": true,
            "max_length": 45,
            "description": "Nombre completo del usuario"
          },
          "telefono": {
            "type": "string",
            "required": true,
            "length": 10,
            "unique": true,
            "description": "Número de teléfono"
          },
          "email": {
            "type": "string",
            "required": true,
            "email": true,
            "unique": true,
            "description": "Email del usuario"
          },
          "password": {
            "type": "string",
            "required": true,
            "min_length": 8,
            "description": "Contraseña del usuario"
          },
          "password_confirmation": {
            "type": "string",
            "required": true,
            "description": "Confirmación de contraseña"
          }
        },
        "responses": {
          "201": {
            "description": "Usuario creado exitosamente",
            "body": {
              "message": "string",
              "user": "object",
              "token": "string"
            }
          },
          "422": {
            "description": "Error de validación",
            "body": {
              "error": "object"
            }
          },
          "500": {
            "description": "Error interno del servidor",
            "body": {
              "error": "string",
              "details": "string"
            }
          }
        }
      }
    },
    "usuarios": {
      "getUser": {
        "method": "GET",
        "url": "/user/me",
        "description": "Obtener información del usuario autenticado",
        "authentication": "JWT required",
        "headers": {
          "Authorization": "Bearer {JWT_TOKEN}",
          "Accept": "application/json"
        },
        "responses": {
          "200": {
            "description": "Información del usuario obtenida",
            "body": "user_object"
          },
          "401": {
            "description": "No autorizado",
            "body": {
              "error": "string"
            }
          }
        }
      },
      "logout": {
        "method": "POST",
        "url": "/user/logout",
        "description": "Cerrar sesión del usuario",
        "authentication": "JWT required",
        "headers": {
          "Authorization": "Bearer {JWT_TOKEN}",
          "Accept": "application/json"
        },
        "responses": {
          "200": {
            "description": "Sesión cerrada exitosamente",
            "body": {
              "message": "string"
            }
          },
          "500": {
            "description": "Error al cerrar sesión",
            "body": {
              "error": "string"
            }
          }
        }
      }
    },
    "doctores": {
      "loginDoctor": {
        "method": "POST",
        "url": "/login-doctor",
        "description": "Autenticación de doctor",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "body": {
          "telefono": {
            "type": "string",
            "required": true,
            "description": "Teléfono del doctor"
          },
          "password": {
            "type": "string",
            "required": true,
            "description": "Contraseña del doctor"
          }
        },
        "responses": {
          "200": {
            "description": "Login exitoso",
            "body": {
              "user": "object",
              "token": "string"
            }
          },
          "401": {
            "description": "Credenciales inválidas",
            "body": {
              "error": "string"
            }
          }
        }
      },
      "registerDoctor": {
        "method": "POST",
        "url": "/register-doctor",
        "description": "Registro de nuevo doctor",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "body": {
          "nombre": {
            "type": "string",
            "required": true,
            "description": "Nombre del doctor"
          },
          "telefono": {
            "type": "string",
            "required": true,
            "description": "Teléfono del doctor"
          },
          "email": {
            "type": "string",
            "required": true,
            "description": "Email del doctor"
          },
          "password": {
            "type": "string",
            "required": true,
            "description": "Contraseña del doctor"
          },
          "cedula": {
            "type": "string",
            "required": true,
            "description": "Cédula profesional"
          },
          "puntos": {
            "type": "string",
            "required": true,
            "description": "Puntos del doctor"
          }
        },
        "responses": {
          "201": {
            "description": "Doctor registrado exitosamente",
            "body": {
              "message": "string",
              "doctor": "object"
            }
          },
          "422": {
            "description": "Error de validación",
            "body": {
              "error": "object"
            }
          }
        }
      },
      "getDoctor": {
        "method": "GET",
        "url": "/doctor/me",
        "description": "Obtener información del doctor autenticado",
        "authentication": "JWT Doctor required",
        "headers": {
          "Authorization": "Bearer {JWT_TOKEN}",
          "Accept": "application/json"
        },
        "responses": {
          "200": {
            "description": "Información del doctor obtenida",
            "body": "doctor_object"
          },
          "401": {
            "description": "No autorizado",
            "body": {
              "error": "string"
            }
          }
        }
      },
      "updateDoctor": {
        "method": "PUT",
        "url": "/doctor/actualizar",
        "description": "Actualizar información del doctor",
        "authentication": "JWT Doctor required",
        "headers": {
          "Authorization": "Bearer {JWT_TOKEN}",
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "body": {
          "nombre": {
            "type": "string",
            "required": false,
            "description": "Nombre del doctor"
          },
          "telefono": {
            "type": "string",
            "required": false,
            "description": "Teléfono del doctor"
          },
          "email": {
            "type": "string",
            "required": false,
            "description": "Email del doctor"
          },
          "cedula": {
            "type": "string",
            "required": false,
            "description": "Cédula profesional"
          },
          "puntos": {
            "type": "string",
            "required": false,
            "description": "Puntos del doctor"
          }
        },
        "responses": {
          "200": {
            "description": "Doctor actualizado exitosamente",
            "body": {
              "message": "string",
              "doctor": "object"
            }
          },
          "401": {
            "description": "No autorizado",
            "body": {
              "error": "string"
            }
          },
          "422": {
            "description": "Error de validación",
            "body": {
              "error": "object"
            }
          }
        }
      }
    },
    "citas": {
      "mostrarCita": {
        "method": "GET",
        "url": "/cita/mostrar",
        "description": "Obtener todas las citas del usuario",
        "authentication": "JWT required",
        "headers": {
          "Authorization": "Bearer {JWT_TOKEN}",
          "Accept": "application/json"
        },
        "query_params": {
          "per_page": {
            "type": "integer",
            "required": false,
            "default": 15,
            "description": "Número de resultados por página"
          },
          "page": {
            "type": "integer",
            "required": false,
            "default": 1,
            "description": "Número de página"
          }
        },
        "responses": {
          "200": {
            "description": "Citas obtenidas exitosamente",
            "body": {
              "citas": "array",
              "pagination": "object"
            }
          },
          "401": {
            "description": "No autorizado",
            "body": {
              "error": "string"
            }
          }
        }
      },
      "mostrarCitaPorId": {
        "method": "GET",
        "url": "/cita/mostrar/{id}",
        "description": "Obtener una cita específica por ID",
        "authentication": "JWT required",
        "headers": {
          "Authorization": "Bearer {JWT_TOKEN}",
          "Accept": "application/json"
        },
        "path_params": {
          "id": {
            "type": "integer",
            "required": true,
            "description": "ID de la cita"
          }
        },
        "responses": {
          "200": {
            "description": "Cita obtenida exitosamente",
            "body": "cita_object"
          },
          "401": {
            "description": "No autorizado",
            "body": {
              "error": "string"
            }
          },
          "404": {
            "description": "Cita no encontrada",
            "body": {
              "error": "string"
            }
          }
        }
      },
      "agregarCita": {
        "method": "POST",
        "url": "/cita/agendar",
        "description": "Crear una nueva cita",
        "authentication": "JWT required",
        "headers": {
          "Authorization": "Bearer {JWT_TOKEN}",
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "body": {
          "fecha": {
            "type": "string",
            "required": true,
            "format": "YYYY-MM-DD HH:mm:ss",
            "description": "Fecha y hora de la cita"
          },
          "motivo": {
            "type": "string",
            "required": true,
            "description": "Motivo de la cita"
          },
          "doctor_id": {
            "type": "integer",
            "required": true,
            "description": "ID del doctor"
          }
        },
        "responses": {
          "201": {
            "description": "Cita creada exitosamente",
            "body": {
              "message": "string",
              "cita": "object"
            }
          },
          "401": {
            "description": "No autorizado",
            "body": {
              "error": "string"
            }
          },
          "422": {
            "description": "Error de validación",
            "body": {
              "error": "object"
            }
          }
        }
      },
      "actualizarCita": {
        "method": "PUT",
        "url": "/cita/actualizar/{id}",
        "description": "Actualizar una cita existente",
        "authentication": "JWT required",
        "headers": {
          "Authorization": "Bearer {JWT_TOKEN}",
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "path_params": {
          "id": {
            "type": "integer",
            "required": true,
            "description": "ID de la cita"
          }
        },
        "body": {
          "fecha": {
            "type": "string",
            "required": false,
            "format": "YYYY-MM-DD HH:mm:ss",
            "description": "Nueva fecha y hora de la cita"
          },
          "motivo": {
            "type": "string",
            "required": false,
            "description": "Nuevo motivo de la cita"
          },
          "doctor_id": {
            "type": "integer",
            "required": false,
            "description": "Nuevo ID del doctor"
          }
        },
        "responses": {
          "200": {
            "description": "Cita actualizada exitosamente",
            "body": {
              "message": "string",
              "cita": "object"
            }
          },
          "401": {
            "description": "No autorizado",
            "body": {
              "error": "string"
            }
          },
          "404": {
            "description": "Cita no encontrada",
            "body": {
              "error": "string"
            }
          },
          "422": {
            "description": "Error de validación",
            "body": {
              "error": "object"
            }
          }
        }
      },
      "cancelarCita": {
        "method": "GET",
        "url": "/cita/cancelar/{id}",
        "description": "Cancelar una cita",
        "authentication": "JWT required",
        "headers": {
          "Authorization": "Bearer {JWT_TOKEN}",
          "Accept": "application/json"
        },
        "path_params": {
          "id": {
            "type": "integer",
            "required": true,
            "description": "ID de la cita"
          }
        },
        "responses": {
          "200": {
            "description": "Cita cancelada exitosamente",
            "body": {
              "message": "string"
            }
          },
          "401": {
            "description": "No autorizado",
            "body": {
              "error": "string"
            }
          },
          "404": {
            "description": "Cita no encontrada",
            "body": {
              "error": "string"
            }
          }
        }
      }
    },
    "analisis": {
      "mostrarAnalisis": {
        "method": "GET",
        "url": "/analisis/mostrar",
        "description": "Obtener todos los análisis del usuario",
        "authentication": "JWT required",
        "headers": {
          "Authorization": "Bearer {JWT_TOKEN}",
          "Accept": "application/json"
        },
        "query_params": {
          "per_page": {
            "type": "integer",
            "required": false,
