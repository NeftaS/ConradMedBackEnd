            "description": "Error de validación",
            "body": {
              "error": "object"
            }
          }
        }
      }
    },
    "ordenes": {
      "index": {
        "method": "GET",
        "url": "/ordenes",
        "description": "Obtener todas las órdenes con filtros y paginación",
        "authentication": "JWT required",
        "headers": {
          "Authorization": "Bearer {JWT_TOKEN}",
          "Accept": "application/json"
        },
        "query_params": {
          "medico": {
            "type": "string",
            "required": false,
            "description": "Filtrar por nombre del médico"
          },
          "paciente": {
            "type": "string",
            "required": false,
            "description": "Filtrar por nombre del paciente"
          },
          "tipo": {
            "type": "string",
            "required": false,
            "description": "Filtrar por tipo de orden"
          },
          "urgencia": {
            "type": "string",
            "required": false,
            "enum": ["BAJA", "MEDIA", "ALTA", "CRITICA"],
            "description": "Filtrar por nivel de urgencia"
          },
          "fecha": {
            "type": "string",
            "required": false,
            "format": "YYYY-MM-DD",
            "description": "Filtrar por fecha específica"
          },
          "fecha_inicio": {
            "type": "string",
            "required": false,
            "format": "YYYY-MM-DD",
            "description": "Fecha de inicio para rango"
          },
          "fecha_fin": {
            "type": "string",
            "required": false,
            "format": "YYYY-MM-DD",
            "description": "Fecha de fin para rango"
          },
          "per_page": {
            "type": "integer",
            "required": false,
            "default": 15,
            "description": "Número de resultados por página"
          },
          "page": {
            "type": "integer",
            "required": false,
            "default": 1,
            "description": "Número de página"
          }
