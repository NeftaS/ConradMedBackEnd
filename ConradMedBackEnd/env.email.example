# Configuración para el sistema de correos con Resend

# Configuración principal de correos
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=noreply@tudominio.com
MAIL_FROM_NAME="ConradMed"

# Configuración de Resend
RESEND_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Configuración de la aplicación
APP_URL=http://localhost:8000
APP_NAME="ConradMed"

# Nota: Reemplaza 'tudominio.com' con tu dominio real
# Obtén tu RESEND_KEY desde: https://resend.com/api-keys

