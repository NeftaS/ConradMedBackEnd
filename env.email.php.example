# Configuración para el sistema de correos con PHP puro

# Configuración principal de correos
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=noreply@tudominio.com
MAIL_FROM_NAME="ConradMed"

# Configuración SMTP (opcional - si usas un servidor SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-contraseña-de-aplicación
MAIL_SCHEME=tls

# Configuración alternativa para sendmail (si no usas SMTP)
# MAIL_MAILER=sendmail
# MAIL_SENDMAIL_PATH=/usr/sbin/sendmail -bs -i

# Configuración de la aplicación
APP_URL=http://localhost:8000
APP_NAME="ConradMed"

# Notas importantes:
# 1. Para Gmail, necesitas usar una "Contraseña de aplicación" en lugar de tu contraseña normal
# 2. Si usas sendmail, asegúrate de que esté instalado y configurado en tu servidor
# 3. Para desarrollo local, puedes usar MAIL_MAILER=log para guardar emails en logs
# 4. Reemplaza 'tudominio.com' con tu dominio real
